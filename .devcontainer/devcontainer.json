{
  "name": "slope-stability",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "waitFor": "updateContentCommand",
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "updateContentCommand": "bash .devcontainer/update-content.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "containerEnv": {
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "MESA_LOADER_DRIVER_OVERRIDE": "llvmpipe",
    "OMPI_MCA_btl_vader_single_copy_mechanism": "none",
    "PROJECT_EXTRAS": "test,viz,cython,partition",
    "PYVISTA_OFF_SCREEN": "true",
    "PYVISTA_TRAME_SERVER_PROXY_ENABLED": "true",
    "PYVISTA_TRAME_SERVER_PROXY_PREFIX": "/proxy/{port}/"
  },
  "remoteEnv": {
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    "PETSC_DIR": "${containerWorkspaceFolder}/.build/src/petsc-3.24.5",
    "PETSC_ARCH": "linux-c-opt",
    "LD_LIBRARY_PATH": "${containerWorkspaceFolder}/.build/src/petsc-3.24.5/linux-c-opt/lib:${containerEnv:LD_LIBRARY_PATH}",
    "PYTHONPATH": "${containerWorkspaceFolder}/src:${containerWorkspaceFolder}/benchmarks:${containerEnv:PYTHONPATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "tamasfe.even-better-toml",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.analysis.extraPaths": [
          "${containerWorkspaceFolder}/src",
          "${containerWorkspaceFolder}/benchmarks"
        ],
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "jupyter.jupyterServerType": "local",
        "jupyter.notebookFileRoot": "${containerWorkspaceFolder}",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}

-pc_variant fetidp
-dm_mat_type is
-mat_is_localmat_type aij
-ksp_type fetidp
-ksp_fetidp_fullyredundant false
-fetidp_ksp_type cg
-bddc_graph topology
-bddc_coordinates scalar
-bddc_collapse_shared true
-bddc_local_solver_auto false
-fetidp_bddc_pc_bddc_use_local_mat_graph false
-fetidp_bddc_pc_bddc_use_vertices false
-fetidp_bddc_pc_bddc_use_edges true
-fetidp_bddc_pc_bddc_use_faces false
-fetidp_bddc_pc_bddc_use_change_of_basis true
-fetidp_bddc_pc_bddc_dirichlet_ksp_type cg
-fetidp_bddc_pc_bddc_dirichlet_pc_type gamg
-fetidp_bddc_pc_bddc_dirichlet_ksp_rtol 1.0e-3
-fetidp_bddc_pc_bddc_dirichlet_approximate true
-fetidp_bddc_pc_bddc_neumann_ksp_type cg
-fetidp_bddc_pc_bddc_neumann_pc_type gamg
-fetidp_bddc_pc_bddc_neumann_ksp_rtol 1.0e-3
-fetidp_bddc_pc_bddc_neumann_approximate true
-fetidp_bddc_pc_bddc_coarse_ksp_type preonly
-fetidp_bddc_pc_bddc_coarse_pc_type gamg
-linear_rtol 1.0e-3
-ksp_converged_reason

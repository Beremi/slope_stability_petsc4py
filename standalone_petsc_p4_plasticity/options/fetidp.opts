-pc_variant fetidp
-dm_mat_type is
-mat_is_localmat_type aij
-ksp_type fetidp
-bddc_graph petsc
-bddc_local_solver_auto false
-bddc_exact_local_max_dofs 8000
-fetidp_bddc_pc_bddc_use_vertices true
-fetidp_bddc_pc_bddc_use_edges true
-fetidp_bddc_pc_bddc_use_faces false
-fetidp_bddc_pc_bddc_use_change_of_basis true
-ksp_fetidp_fullyredundant false
-fetidp_ksp_type gmres
-linear_rtol 1.0e-3
-ksp_converged_reason

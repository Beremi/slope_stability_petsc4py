-pc_variant bddc
-dm_mat_type is
-mat_is_localmat_type aij
-ksp_type cg
-pc_type bddc
-bddc_graph topology
-bddc_coordinates scalar
-bddc_collapse_shared true
-bddc_local_solver_auto false
-pc_bddc_use_local_mat_graph false
-pc_bddc_use_vertices false
-pc_bddc_use_edges true
-pc_bddc_use_faces false
-pc_bddc_use_change_of_basis true
-pc_bddc_dirichlet_ksp_type cg
-pc_bddc_dirichlet_pc_type gamg
-pc_bddc_dirichlet_ksp_rtol 1.0e-3
-pc_bddc_dirichlet_approximate true
-pc_bddc_neumann_ksp_type cg
-pc_bddc_neumann_pc_type gamg
-pc_bddc_neumann_ksp_rtol 1.0e-3
-pc_bddc_neumann_approximate true
-pc_bddc_coarse_ksp_type preonly
-pc_bddc_coarse_pc_type gamg
-linear_rtol 1.0e-3
-ksp_converged_reason

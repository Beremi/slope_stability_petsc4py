-pc_variant pmg
-pmg_apply_backend shell_vcycle
-ksp_type fgmres
-ksp_norm_type unpreconditioned
-dm_plex_partition_balance true

# Match the petsc4py pmg_shell baseline as closely as the C shell backend allows.
-pmg_shell_p2_active_ranks 64
-pmg_shell_p1_active_ranks 32
-pmg_shell_subcomm_type interlaced
-pmg_p2_telescope_active_ranks 0

# P4 and P2 smoothers.
-pmg_smoother_ksp_type chebyshev
-pmg_smoother_pc_type jacobi
-pmg_smoother_max_it 3

# P1 coarse solve: petsc4py manualmg_coarse is preonly + hypre/boomeramg.
-pmg_coarse_telescope_ksp_type preonly
-pmg_coarse_telescope_ksp_rtol 1e-10
-pmg_coarse_telescope_ksp_max_it 200
-pmg_coarse_telescope_pc_type hypre
-pmg_shell_p1_pc_hypre_boomeramg_max_iter 4
-pmg_shell_p1_pc_hypre_boomeramg_tol 0.0
-pmg_shell_p1_pc_hypre_boomeramg_coarsen_type HMIS
-pmg_shell_p1_pc_hypre_boomeramg_interp_type ext+i
-pmg_shell_p1_pc_hypre_boomeramg_P_max 4
-pmg_shell_p1_pc_hypre_boomeramg_strong_threshold 0.5
-pmg_shell_p1_pc_hypre_boomeramg_grid_sweeps_all 1
-pmg_shell_p1_pc_hypre_boomeramg_cycle_type V
-pmg_shell_p1_pc_hypre_boomeramg_agg_nl 0

# Match the petsc4py exported-step replay Krylov algebra.
-deflation true
-deflation_solver matlab_dfgmres
-linear_rtol 1.0e-1
-ksp_max_it 200
-ksp_converged_reason

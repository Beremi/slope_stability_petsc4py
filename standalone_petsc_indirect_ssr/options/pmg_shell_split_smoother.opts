# C shell V-cycle profile used for the omega=7e6 SSR scalability follow-up.
# It keeps the maintained scalable active-layout PMG baseline, but spends more
# smoothing on the P4 and P2 shell levels. Local 32-rank omega=7e6 run:
#   baseline smoother 2/2: 169.30s continuation wall, 1446 linear iterations
#   split fine=5,p2=10:   149.15s continuation wall, 724 linear iterations

-pc_variant pmg
-pmg_apply_backend shell_vcycle
-ksp_type fgmres
-ksp_norm_type unpreconditioned
-dm_plex_partition_balance true
-pmg_coarse_pc_type gamg
-pmg_coarse_lu_max_dofs 50000
-pmg_coarse_redundant_group_size 0
-pmg_coarse_gamg_aggressive_square_graph false
-pmg_shell_p2_active_ranks 64
-pmg_shell_p1_active_ranks 32
-pmg_shell_subcomm_type interlaced
-pmg_coarse_telescope_ksp_type fgmres
-pmg_coarse_telescope_ksp_rtol 1e-3
-pmg_coarse_telescope_ksp_max_it 100
-pmg_coarse_telescope_pc_type gamg
-pmg_p2_telescope_active_ranks 0
-pmg_smoother_ksp_type chebyshev
-pmg_smoother_pc_type jacobi
-pmg_smoother_max_it 2

# Split smoother overrides:
# - P4/fine smoother does most of the convergence-rate work.
# - P2 smoother is cheaper and helps keep the hard continuation steps stable.
-pmg_shell_fine_ksp_max_it 5
-pmg_shell_p2_ksp_max_it 10

-deflation true
-linear_rtol 1.0e-1
-ksp_max_it 200
-ksp_converged_reason

# Keep the presentation sources and final PDF under version control.
!/.gitignore
!/Makefile
!/presentation_petsc_rewrite.tex
!/theme.tex
!/speaker-notes.md
!/presentation_petsc_rewrite.pdf

# Track only the assets that the deck currently uses.
!/assets/
/assets/*
!/assets/reference_tetra_quadratures.pdf
!/assets/homo_3d_continuation.pdf
!/assets/homo_3d_timings.pdf
!/assets/homo_3d_p2_vs_p4_curves.pdf
!/assets/hetero_3d_continuation.pdf
!/assets/hetero_3d_timings.pdf
!/assets/hetero_3d_p2_vs_p4_curves.pdf
!/assets/seepage_3d_continuation.pdf
!/assets/seepage_3d_timings.pdf
!/assets/hetero_3d_delta_lambda_continuation.pdf
!/assets/hetero_3d_delta_lambda_timings.pdf
!/assets/petsc_geometry_current.png
!/assets/petsc_displacement_current.png
!/assets/petsc_deviatoric_surface_current.png
!/assets/petsc_slices_current.png
!/assets/matlab_slices_present.png

# Ignore LaTeX build byproducts and generated previews.
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz
/preview/
/preview_*/
